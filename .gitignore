# === SCITBD trace — GitHub-safe ignores ===
# Secrets: never push keys (see .env.example files for the required names)
.env
*/.env
!*/.env.example

# SQLite databases (auto-created on boot by schema/bootstrappers; hold live data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# JS build deps (reinstall: npm install in remotion-composer/)
node_modules/

# Generated / runtime (rebuilt on demand)
data/.cache/
data/video-projects/
sccrm/uploads/
autoflows/storage/*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
