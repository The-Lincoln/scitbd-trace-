# Protect data directory + secrets (NEVER serve .env / keys)
<Files ".env">
    Require all denied
</Files>
<Files "*.db">
    Require all denied
</Files>
<FilesMatch "\.(db|sqlite|sqlite3)$">
    Require all denied
</FilesMatch>

# Block direct access to includes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>

# Default charset
AddDefaultCharset UTF-8

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
