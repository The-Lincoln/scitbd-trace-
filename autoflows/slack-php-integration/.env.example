# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_USER_ID=UYOURAPPID
SLACK_WORKSPACE_ID=WYOURWORKSPACEID
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# App Configuration
APP_NAME=SCITBD Slack Integration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:8080

# Database (optional, for storing messages/logs)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slack_integration
DB_USER=root
DB_PASS=

# Logging
LOG_CHANNEL=default
LOG_LEVEL=debug
